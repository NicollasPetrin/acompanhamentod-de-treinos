# Ambiente
NODE_ENV=development
PORT=3333

# Banco de dados
# SQLite (padrão, zero configuração):
DATABASE_URL="file:./dev.db"
# Em produção com banco serverless (Neon, Supabase), além da DATABASE_URL com
# pool de conexões, informe a conexão direta usada para criar as tabelas:
# DIRECT_URL="postgresql://..."
# PostgreSQL (produção) — troque também `provider` em prisma/schema.prisma:
# DATABASE_URL="postgresql://usuario:senha@localhost:5432/treinos?schema=public"

# JWT — troque os segredos em produção!
JWT_ACCESS_SECRET="troque-este-segredo-de-acesso-em-producao"
JWT_REFRESH_SECRET="troque-este-segredo-de-refresh-em-producao"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_SHORT_TTL_DAYS=1

# Frontend / CORS
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Fotos (perfil e progresso) — guardadas no banco, comprimidas pelo app
MAX_UPLOAD_MB=5

# E-mail (opcional — sem SMTP os e-mails são impressos no console)
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_USER=usuario
# SMTP_PASS=senha
MAIL_FROM="Treinos <nao-responda@treinos.app>"

# Notificações do treino (Web Push) — tudo opcional.
# Sem chaves VAPID o servidor gera um par na primeira vez e guarda no banco.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:voce@exemplo.com
# Hospedagem serverless (Vercel): o aviso de fim do descanso com o app fechado
# precisa de um agendador. Crie uma conta grátis em upstash.com → QStash.
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
# QSTASH_URL=https://qstash.upstash.io
# Endereço público da API (a Vercel e o Render já informam sozinhos)
# API_PUBLIC_URL=https://treinos-api.vercel.app
