# Endereço da API.
#
# Em desenvolvimento deixe vazio ou não crie este arquivo: o Vite já faz proxy
# de /api para http://localhost:3333.
#
# Em produção, quando o site e a API ficam em domínios diferentes (por exemplo
# na Vercel), aponte para a URL da API:
# VITE_API_URL=https://treinos-api.vercel.app
